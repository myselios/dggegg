#!/usr/bin/env bash
# ============================================================
# Pre-commit hook: 시크릿(JWT, Supabase URL, 서비스 키) 커밋 차단
# 활성화: git config core.hooksPath .githooks
# ============================================================

set -euo pipefail

# 스테이징된 파일 중 텍스트 파일만
staged_files=$(git diff --cached --name-only --diff-filter=ACM)
if [[ -z "$staged_files" ]]; then
  exit 0
fi

violations=()

check_file() {
  local file="$1"

  # 바이너리 스킵
  if ! git diff --cached --name-only --diff-filter=ACM -- "$file" | grep -q .; then
    return
  fi

  # 스테이징된 실제 내용 (파일 삭제 대응 위해 blob에서 읽음)
  local content
  content=$(git show ":$file" 2>/dev/null || true)
  [[ -z "$content" ]] && return

  # 1) Supabase JWT (eyJ로 시작하는 매우 긴 토큰 — 서비스 롤 또는 anon 프로덕션 키)
  #    로컬 데모 키(iss=supabase-demo)는 예외 처리
  local jwt_lines
  jwt_lines=$(echo "$content" | grep -nE "eyJ[A-Za-z0-9_-]{20,}\.eyJ[A-Za-z0-9_-]{50,}\.[A-Za-z0-9_-]{20,}" || true)
  if [[ -n "$jwt_lines" ]]; then
    while IFS= read -r line; do
      if ! echo "$line" | grep -q "supabase-demo"; then
        violations+=("$file: JWT 토큰 발견 → $(echo "$line" | cut -c1-120)")
      fi
    done <<< "$jwt_lines"
  fi

  # 2) Supabase 프로젝트 URL (프로덕션 프로젝트 ID)
  local url_lines
  url_lines=$(echo "$content" | grep -nE "https://[a-z]{20}\.supabase\.co" || true)
  if [[ -n "$url_lines" ]]; then
    while IFS= read -r line; do
      violations+=("$file: Supabase 프로덕션 URL 발견 → $(echo "$line" | cut -c1-120)")
    done <<< "$url_lines"
  fi

  # 3) 하드코딩 시크릿 패턴
  local secret_lines
  secret_lines=$(echo "$content" | grep -nE "(SERVICE_ROLE|SECRET|API_KEY|PASSWORD)\s*=\s*[\"'][A-Za-z0-9_.-]{20,}[\"']" || true)
  if [[ -n "$secret_lines" ]]; then
    while IFS= read -r line; do
      # 명백한 예제/placeholder 제외
      if echo "$line" | grep -qE "(YOUR_|EXAMPLE|PLACEHOLDER|xxx|<REDACTED>|process\.env)"; then
        continue
      fi
      violations+=("$file: 시크릿 패턴 발견 → $(echo "$line" | cut -c1-120)")
    done <<< "$secret_lines"
  fi
}

while IFS= read -r file; do
  # 스킵할 파일: lock/binary/pdf 등
  case "$file" in
    *.lock|*.png|*.jpg|*.jpeg|*.gif|*.pdf|*.zip|package-lock.json|*.githooks/*)
      continue
      ;;
  esac
  check_file "$file"
done <<< "$staged_files"

if [[ ${#violations[@]} -gt 0 ]]; then
  echo ""
  echo "❌ 커밋 차단 — 시크릿 노출 위험이 감지되었습니다:"
  echo ""
  for v in "${violations[@]}"; do
    echo "  • $v"
  done
  echo ""
  echo "해결 방법:"
  echo "  1. 시크릿을 .env.local로 이동 (.gitignore에 이미 포함됨)"
  echo "  2. 코드에서는 process.env.XXX로 참조"
  echo "  3. git reset HEAD <file> 로 스테이징 취소"
  echo ""
  echo "정말 안전한 값이라 우회가 필요하면: git commit --no-verify"
  echo "(권장하지 않음)"
  echo ""
  exit 1
fi

exit 0
